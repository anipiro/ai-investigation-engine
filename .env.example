# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Qdrant Cloud (leave empty to use embedded local storage in QDRANT_PATH)
QDRANT_URL=
QDRANT_API_KEY=
# Required to update/delete documents of the seed corpus through the API
ADMIN_TOKEN=
# Optional tuning
# CHUNK_STRATEGY=recursive
# ENABLE_CROSS_ENCODER=true
# ASK_RATE_PER_MINUTE=12
